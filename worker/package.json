{
  "name": "deewhy-preview-recorder",
  "private": true,
  "version": "1.0.0",
  "description": "Self-hosted homepage recorder for Deewhy HQ Preview Studio (Playwright + FFmpeg).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --import tsx src/main.ts",
    "record": "node --import tsx src/cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "playwright": "1.56.1",
    "tsx": "4.20.6"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "typescript": "^5.8.3"
  }
}
